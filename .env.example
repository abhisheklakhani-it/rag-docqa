# Copy this file to .env and fill in your key (never commit .env)

# Option 1: Claude
ANTHROPIC_API_KEY=

# Option 2: any Anthropic-compatible endpoint, e.g. Ollama Cloud (free tier, key from ollama.com/settings/keys)
# ANTHROPIC_BASE_URL=https://ollama.com
# ANTHROPIC_AUTH_TOKEN=
# RAGQA_MODEL=gpt-oss:120b

# Optional
# RAGQA_RETRIEVER=hybrid          # hybrid | bm25 | dense | tfidf
# RAGQA_OCR=auto                  # auto | off
